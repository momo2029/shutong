<h2>知识库问答</h2>
<div class="card mt-2">
  <form id="askForm">
    <div class="form-group">
      <label>基于你的所有课堂笔记，想问什么？</label>
      <textarea name="question" class="form-input" rows="3" placeholder="例如：本学期高数课讲了哪些重点定理？"></textarea>
    </div>
    <button type="submit" class="btn btn-primary">提问</button>
  </form>
</div>
<div id="answer" class="card mt-2" style="display:none;">
  <h4>回答</h4>
  <div id="answerContent"></div>
</div>

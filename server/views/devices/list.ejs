<div class="flex-between">
  <h2>我的设备</h2>
  <a href="/devices/bind" class="btn btn-primary">＋ 绑定新设备</a>
</div>
<% if (devices.length === 0) { %>
<div class="card mt-2">
  <p class="text-muted text-center">暂无设备，点击上方按钮绑定</p>
</div>
<% } else { %>
<div class="device-grid mt-2">
  <% devices.forEach(device => { %>
  <div class="device-card <%= device.online ? 'online' : 'offline' %>">
    <div class="device-card-header">
      <div class="device-name-row">
        <span class="status-dot <%= device.online ? 'dot-online' : 'dot-offline' %>"></span>
        <h3 class="device-name"><%= device.name %></h3>
        <span class="tag <%= device.type === 'flagship' ? 'tag-flagship' : 'tag-standard' %>">
          <%= device.type === 'flagship' ? '旗舰版' : '标准版' %>
        </span>
      </div>
      <span class="device-status-text <%= device.online ? 'text-online' : 'text-offline' %>">
        <%= device.online ? '在线' : '离线' %>
      </span>
    </div>
    <div class="device-card-body">
      <div class="device-info-row">
        <span class="info-label">序列号</span>
        <span class="info-value mono"><%= device.sn %></span>
      </div>
      <div class="device-info-row">
        <span class="info-label">固件版本</span>
        <span class="info-value"><%= device.firmwareVersion || '—' %></span>
      </div>
      <div class="device-info-row">
        <span class="info-label">最后在线</span>
        <span class="info-value"><%= device.lastSeen ? new Date(device.lastSeen).toLocaleString('zh-CN') : '—' %></span>
      </div>
      <div class="device-info-row">
        <span class="info-label">绑定时间</span>
        <span class="info-value"><%= new Date(device.createdAt).toLocaleString('zh-CN') %></span>
      </div>
    </div>
    <div class="device-card-footer">
      <a href="/devices/<%= device.id %>" class="btn btn-outline btn-sm">设备详情</a>
    </div>
  </div>
  <% }) %>
</div>
<% } %>

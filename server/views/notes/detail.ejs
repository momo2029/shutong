<div class="flex-between">
  <h2><%= note.title %></h2>
  <div style="display:flex;gap:8px;align-items:center;">
    <% if (note.status === 'recording') { %>
      <span class="tag tag-recording">● 录制中</span>
      <button class="btn btn-error btn-sm" onclick="stopRecording()">⏹ 停止录音</button>
    <% } else if (note.status === 'paused') { %>
      <span class="tag tag-warning">⏸ 已暂停</span>
      <button class="btn btn-primary btn-sm" onclick="resumeRecording()">▶ 继续录音</button>
    <% } else if (note.status === 'ready') { %>
      <span class="tag tag-success">已完成</span>
      <button class="btn btn-outline btn-sm" onclick="capturePhoto()">📷 拍照</button>
    <% } else if (note.status === 'processing') { %>
      <span class="tag tag-warning">处理中</span>
    <% } else if (note.status === 'failed') { %>
      <span class="tag tag-error">处理失败</span>
    <% } %>
  </div>
</div>

<div class="card mt-2">
  <div class="note-card-meta" style="margin-bottom:12px;">
    <span>📅 <%= note.createdAt && note.createdAt[0] !== '(' ? new Date(new Date(note.createdAt).getTime() + 8*3600000).toISOString().replace('T',' ').substring(0,19) : '未知' %></span>
    <% if (note.duration) { %>
      <span>⏱ <%= (note.duration / 60).toFixed(0) %> 分 <%= note.duration % 60 %> 秒</span>
    <% } %>
    <% if (note.tags) { %>
      <span>🏷 <%= note.tags %></span>
    <% } %>
    <% if (typeof courseName !== 'undefined' && courseName) { %>
      <span>📚 <%= courseName %></span>
    <% } %>
  </div>

  <% if (note.audioPath) { %>
  <div id="waveform" style="margin-bottom:8px;border-radius:8px;background:#f1f5f9;"></div>
  <div style="display:flex;gap:8px;align-items:center;margin-bottom:4px;">
    <button id="playBtn" class="btn btn-outline btn-sm" onclick="togglePlay()">▶ 播放</button>
    <span id="timeDisplay" style="font-size:13px;color:var(--text-muted);font-family:monospace;">0:00 / 0:00</span>
  </div>
  <% } %>

  <% if (images && images.length > 0) { %>
  <div style="margin-top:16px;">
    <h4 style="margin-bottom:8px;">📷 课堂照片 (<%= images.length %> 张)</h4>
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:8px;">
      <% images.forEach(img => { %>
      <a href="<%= img.imagePath %>" target="_blank" style="display:block;">
        <img src="<%= img.imagePath %>" style="width:100%;height:150px;object-fit:cover;border-radius:6px;border:1px solid var(--border);" loading="lazy">
      </a>
      <% }) %>
    </div>
  </div>
  <% } %>
</div>

<div class="card mt-2">
  <h4>🤖 AI 摘要</h4>
  <% if (note.aiSummary) { %>
    <div class="md-body"><%- note.aiSummaryHtml %></div>
  <% } else { %>
    <p class="text-muted"><%= note.status === 'processing' ? '等待AI处理...' : (note.status === 'paused' ? '录音已暂停' : (note.status === 'recording' ? '录音中...' : '暂无摘要')) %></p>
  <% } %>
</div>

<div class="card mt-2">
  <h4>📌 考试重点</h4>
  <% if (note.examPoints) { %>
    <div class="md-body"><%- note.examPointsHtml %></div>
  <% } else { %>
    <p class="text-muted"><%= note.status === 'processing' ? '等待AI处理...' : '暂无考试重点' %></p>
  <% } %>
</div>

<div class="card mt-2">
  <h4>🧠 思维导图 <button class="btn btn-outline btn-sm" onclick="toggleMindMap()" id="mmToggle">切换脑图视图</button></h4>
  <% if (note.mindMap) { %>
    <div id="mmText" class="md-body"><%- note.mindMapHtml %></div>
    <div id="mmCanvas" style="display:none;width:100%;height:600px;border-radius:8px;background:#fafafa;"></div>
    <pre id="mmRaw" style="display:none;"><%= note.mindMap %></pre>
  <% } else { %>
    <p class="text-muted"><%= note.status === 'processing' ? '等待AI处理...' : '暂无思维导图' %></p>
  <% } %>
  <div style="margin-top:16px;display:flex;gap:8px;align-items:center;justify-content:space-between;">
    <a href="/notes" class="btn btn-outline btn-sm">← 返回笔记列表</a>
    <button class="btn btn-danger btn-sm" onclick="deleteNote()">🗑 删除笔记</button>
  </div>
</div>

<div class="card mt-2">
  <h4>📝 原文转录</h4>
  <% if (note.rawTranscript) { %>
    <div class="md-body"><%= note.rawTranscript %></div>
  <% } else { %>
    <p class="text-muted"><%= note.status === 'recording' ? '转写中...' : (note.status === 'paused' ? '录音已暂停' : (note.status === 'processing' ? '转录中...' : '暂无转录内容')) %></p>
  <% } %>
</div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/wavesurfer.js@7/dist/wavesurfer.min.css">
<script src="https://cdn.jsdelivr.net/npm/wavesurfer.js@7/dist/wavesurfer.esm.js" type="module"></script>
<script src="https://cdn.jsdelivr.net/npm/d3@7.9.0/dist/d3.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/markmap-lib@0.18.10/dist/browser/index.js"></script>
<script src="https://cdn.jsdelivr.net/npm/markmap-view@0.18.10/dist/browser/index.js"></script>
<script>
let ws = null;

async function initWaveform() {
  const WaveSurfer = (await import('https://cdn.jsdelivr.net/npm/wavesurfer.js@7/dist/wavesurfer.esm.js')).default;
  ws = WaveSurfer.create({
    container: '#waveform',
    waveColor: '#4f46e5',
    progressColor: '#4338ca',
    barWidth: 2,
    barGap: 1,
    barRadius: 2,
    height: 80,
    url: '<%= note.audioPath %>',
  });
  ws.on('ready', () => {
    document.getElementById('timeDisplay').textContent = '0:00 / ' + formatTime(ws.getDuration());
  });
  ws.on('audioprocess', () => {
    document.getElementById('timeDisplay').textContent = formatTime(ws.getCurrentTime()) + ' / ' + formatTime(ws.getDuration());
  });
}

function formatTime(t) {
  const m = Math.floor(t / 60);
  const s = Math.floor(t % 60);
  return m + ':' + (s < 10 ? '0' : '') + s;
}

window.togglePlay = function() {
  if (!ws) return;
  ws.playPause();
  document.getElementById('playBtn').textContent = ws.isPlaying() ? '⏸ 暂停' : '▶ 播放';
};

document.addEventListener('DOMContentLoaded', () => {
  <% if (note.audioPath) { %>
  initWaveform();
  <% } %>

  // 录制中：轮询标记正在查看 + 自动刷新转录内容
  <% if (note.status === 'recording') { %>
  const viewingInterval = setInterval(() => {
    fetch('/api/notes/<%= note.id %>/viewing', { method: 'POST' }).catch(() => {});
  }, 5000);

  // 每 8 秒自动刷新转录内容
  let refreshTimer = null;
  function scheduleRefresh() {
    refreshTimer = setTimeout(() => {
      fetch(window.location.href, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
        .then(r => r.text())
        .then(html => {
          const parser = new DOMParser();
          const doc = parser.parseFromString(html, 'text/html');
          const newTranscript = [...doc.querySelectorAll('.md-body')].pop();
          const oldCards = document.querySelectorAll('.md-body');
          const oldTranscript = oldCards[oldCards.length - 1];
          if (newTranscript && oldTranscript && newTranscript.textContent !== oldTranscript.textContent) {
            oldTranscript.textContent = newTranscript.textContent;
          }
          // 检查是否已结束录制
          const newTag = doc.querySelector('.tag');
          if (newTag && !newTag.classList.contains('tag-recording')) {
            window.location.reload();
          }
        }).catch(() => {}).finally(() => {
          scheduleRefresh();
        });
    }, 15000);
  }
  scheduleRefresh();

  window.addEventListener('beforeunload', () => { clearInterval(viewingInterval); clearTimeout(refreshTimer); });
  <% } %>
});

// ─── 思维导图 ──────────────────────────────────────
let mmRendered = false;
window.toggleMindMap = function() {
  const text = document.getElementById('mmText');
  const canvas = document.getElementById('mmCanvas');
  const btn = document.getElementById('mmToggle');
  if (!text || !canvas) return;

  if (canvas.style.display === 'none') {
    text.style.display = 'none';
    canvas.style.display = 'block';
    btn.textContent = '切换文本视图';
    if (!mmRendered) renderMindMap();
  } else {
    text.style.display = 'block';
    canvas.style.display = 'none';
    btn.textContent = '切换脑图视图';
  }
};

function renderMindMap() {
  const canvas = document.getElementById('mmCanvas');
  const pre = document.getElementById('mmRaw');
  if (!canvas || !pre) return;

  const raw = pre.textContent;
  let json;
  try {
    // 去掉 markdown 代码块标记
    const clean = raw.replace(/^```[\w]*\n?/, '').replace(/\n?```$/, '');
    json = JSON.parse(clean);
  } catch(e) {
    canvas.innerHTML = '<p class="text-muted">思维导图JSON解析失败</p>';
    return;
  }

  // 递归转换 JSON 为 markdown 列表
  function toMarkdown(obj, depth) {
    if (typeof obj === 'string') return '  '.repeat(depth) + '- ' + obj + '\n';
    let md = '';
    const name = obj['名称'] || obj['中心主题'] || '';
    const desc = obj['说明'] || '';
    const children = obj['子节点'] || obj['分支'] || [];
    if (name) md += '  '.repeat(depth) + '- **' + name + '**' + (desc ? ': ' + desc : '') + '\n';
    if (Array.isArray(obj)) {
      for (const child of obj) md += toMarkdown(child, depth + 1);
    } else if (children.length > 0) {
      for (const child of children) md += toMarkdown(child, depth + 1);
    }
    return md;
  }

  const mdContent = toMarkdown(json, 0);
  if (mdContent) {
    const { Transformer } = window.markmap;
    const transformer = new Transformer();
    const { root } = transformer.transform(mdContent);
    const { Markmap } = window.markmap;
    Markmap.create('#mmCanvas', {
      colorFreezeLevel: 2,
      duration: 300,
      maxWidth: 300,
      nodeMinHeight: 24,
      spacingHorizontal: 60,
      spacingVertical: 8,
      zoomOnMaxHeight: true,
      pan: true,
      zoom: true,
    }, root);
    mmRendered = true;
  }
}

async function deleteNote() {
  if (!confirm('确定删除这条笔记？相关音频和照片也会被删除。')) return;
  try {
    const res = await fetch('/api/notes/<%= note.id %>', { method: 'DELETE' });
    const data = await res.json();
    if (data.ok) {
      window.location.href = '/notes';
    } else {
      alert('删除失败: ' + (data.error || '未知错误'));
    }
  } catch(e) {
    alert('请求失败');
  }
}

async function stopRecording() {
  if (!confirm('确定停止录音？')) return;
  try {
    const res = await fetch('/api/notes/<%= note.id %>/stop-recording', { method: 'POST' });
    const data = await res.json();
    if (data.ok) {
      window.location.reload();
    } else {
      alert('操作失败: ' + (data.error || '未知错误'));
    }
  } catch(e) {
    alert('请求失败');
  }
}

async function resumeRecording() {
  try {
    const res = await fetch('/api/notes/<%= note.id %>/resume-recording', { method: 'POST' });
    const data = await res.json();
    if (data.ok) {
      alert('已发送录音指令，设备检测到声音后将创建新笔记继续录音');
      window.location.href = '/notes';
    } else {
      alert('操作失败: ' + (data.error || '未知错误'));
    }
  } catch(e) {
    alert('请求失败');
  }
}

async function capturePhoto() {
  try {
    const res = await fetch('/api/notes/<%= note.id %>/capture', { method: 'POST' });
    const data = await res.json();
    if (data.ok) {
      alert('拍照指令已发送，请稍后刷新查看照片');
      setTimeout(() => window.location.reload(), 3000);
    } else {
      alert('操作失败: ' + (data.error || '未知错误'));
    }
  } catch(e) {
    alert('请求失败');
  }
}
</script>

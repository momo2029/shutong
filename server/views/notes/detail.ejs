<div class="flex-between">
  <h2><%= note.title %></h2>
  <div style="display:flex;gap:8px;align-items:center;">
    <% if (note.status === 'recording') { %>
      <span class="tag tag-recording">● 录制中</span>
      <button class="btn btn-error btn-sm" onclick="stopRecording()">⏹ 停止录音</button>
    <% } else if (note.status === 'paused') { %>
      <span class="tag tag-warning">⏸ 已暂停</span>
      <button class="btn btn-primary btn-sm" onclick="resumeRecording()">▶ 继续录音</button>
    <% } else if (note.status === 'ready') { %>
      <span class="tag tag-success">已完成</span>
      <button class="btn btn-outline btn-sm" onclick="capturePhoto()">📷 拍照</button>
    <% } else if (note.status === 'processing') { %>
      <span class="tag tag-warning">处理中</span>
      <span style="font-size:12px;color:var(--text-muted);">语音识别 → 大模型润色 → 提取摘要重点</span>
    <% } else if (note.status === 'failed') { %>
      <span class="tag tag-error">处理失败</span>
    <% } %>
  </div>
</div>

<% if (!note.courseId && note.suggestedCourseId && typeof suggestedCourseName !== 'undefined' && suggestedCourseName) { %>
<div class="card mt-2" style="border-left:4px solid var(--primary);">
  <div class="flex-between" style="gap:12px;">
    <div>建议归类到课程：<strong><%= suggestedCourseName %></strong></div>
    <div style="display:flex;gap:8px;">
      <button class="btn btn-primary btn-sm" onclick="confirmCourseSuggestion()">确认</button>
      <button class="btn btn-outline btn-sm" onclick="dismissCourseSuggestion()">忽略</button>
    </div>
  </div>
</div>
<% } %>

<div class="card mt-2">
  <div class="note-card-meta" style="margin-bottom:12px;">
    <span>📅 <%= note.createdAt && note.createdAt[0] !== '(' ? new Date(new Date(note.createdAt).getTime() + 8*3600000).toISOString().replace('T',' ').substring(0,19) : '未知' %></span>
    <% if (note.duration) { %>
      <span>⏱ <%= (note.duration / 60).toFixed(0) %> 分 <%= note.duration % 60 %> 秒</span>
    <% } %>
    <% if (note.tags) { %>
      <span>🏷 <%= note.tags %></span>
    <% } %>
    <% if (typeof courseName !== 'undefined' && courseName) { %>
      <span>📚 <%= courseName %></span>
    <% } %>
  </div>

  <% if (note.audioPath) { %>
  <div id="waveform" style="margin-bottom:8px;border-radius:8px;background:#f1f5f9;"></div>
  <div style="display:flex;gap:8px;align-items:center;margin-bottom:4px;">
    <button id="playBtn" class="btn btn-outline btn-sm" onclick="togglePlay()">▶ 播放</button>
    <span id="timeDisplay" style="font-size:13px;color:var(--text-muted);font-family:monospace;">0:00 / 0:00</span>
  </div>
  <% } %>

  <% if (images && images.length > 0) { %>
  <div style="margin-top:16px;">
    <h4 style="margin-bottom:8px;">📷 课堂照片 (<%= images.length %> 张)</h4>
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:8px;">
      <% images.forEach(img => { %>
      <a href="<%= img.imagePath %>" target="_blank" style="display:block;">
        <img src="<%= img.imagePath %>" style="width:100%;height:150px;object-fit:cover;border-radius:6px;border:1px solid var(--border);" loading="lazy">
      </a>
      <% }) %>
    </div>
  </div>
  <% } %>
</div>

<div class="card mt-2">
  <h4>🤖 AI 摘要</h4>
  <% if (note.aiSummary) { %>
    <div class="md-body"><%- note.aiSummaryHtml %></div>
  <% } else { %>
    <p class="text-muted"><%= note.status === 'processing' ? '等待AI处理...' : (note.status === 'paused' ? '录音已暂停' : (note.status === 'recording' ? '录音中...' : '暂无摘要')) %></p>
  <% } %>
</div>

<div class="card mt-2">
  <h4>📌 考试重点</h4>
  <% if (note.examPoints) { %>
    <div class="md-body"><%- note.examPointsHtml %></div>
  <% } else { %>
    <p class="text-muted"><%= note.status === 'processing' ? '等待AI处理...' : '暂无考试重点' %></p>
  <% } %>
</div>

<div class="card mt-2">
  <h4>🧠 思维导图 <button class="btn btn-outline btn-sm" onclick="toggleMindMap()" id="mmToggle">切换脑图视图</button></h4>
  <% if (note.mindMap) { %>
    <div id="mmText" class="md-body"><%- note.mindMapHtml %></div>
    <div id="mmCanvas" style="display:none;width:100%;height:600px;border-radius:8px;background:#fafafa;"></div>
    <pre id="mmRaw" style="display:none;"><%= note.mindMap %></pre>
  <% } else { %>
    <p class="text-muted"><%= note.status === 'processing' ? '等待AI处理...' : '暂无思维导图' %></p>
  <% } %>
  <div style="margin-top:16px;display:flex;gap:8px;align-items:center;justify-content:space-between;">
    <a href="/notes" class="btn btn-outline btn-sm">← 返回笔记列表</a>
    <button class="btn btn-danger btn-sm" onclick="deleteNote()">🗑 删除笔记</button>
  </div>
</div>

<div class="card mt-2">
  <h4>📝 原文转录</h4>
  <% if (note.rawTranscript) { %>
    <div class="md-body"><%= note.rawTranscript %></div>
  <% } else { %>
    <p class="text-muted"><%= note.status === 'recording' ? '转写中...' : (note.status === 'paused' ? '录音已暂停' : (note.status === 'processing' ? '转录中...' : '暂无转录内容')) %></p>
  <% } %>
</div>

<div class="card mt-2" id="revisionCard" style="display:none;">
  <h4 style="cursor:pointer;" onclick="document.getElementById('revisionBody').style.display = document.getElementById('revisionBody').style.display === 'none' ? 'block' : 'none'">
    📋 修改日志 <span id="revisionCount" style="font-weight:400;font-size:13px;color:var(--text-muted);"></span>
    <span style="float:right;font-size:13px;color:var(--text-muted);"><span id="revisionArrow">▶</span></span>
  </h4>
  <div id="revisionBody" style="display:none;margin-top:12px;">
    <div id="revisionTimeline" style="max-height:400px;overflow-y:auto;"></div>
  </div>
</div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/wavesurfer.js@7/dist/wavesurfer.min.css">
<script src="https://cdn.jsdelivr.net/npm/wavesurfer.js@7/dist/wavesurfer.esm.js" type="module"></script>
<script src="https://cdn.jsdelivr.net/npm/d3@7.9.0/dist/d3.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/markmap-lib@0.18.10/dist/browser/index.js"></script>
<script>window.__mmLib = window.markmap;</script>
<script src="https://cdn.jsdelivr.net/npm/markmap-view@0.18.10/dist/browser/index.js"></script>
<script>window.markmap = { ...window.__mmLib, ...window.markmap };</script>
<script>
let ws = null;

async function initWaveform() {
  const WaveSurfer = (await import('https://cdn.jsdelivr.net/npm/wavesurfer.js@7/dist/wavesurfer.esm.js')).default;
  ws = WaveSurfer.create({
    container: '#waveform',
    waveColor: '#4f46e5',
    progressColor: '#4338ca',
    barWidth: 2,
    barGap: 1,
    barRadius: 2,
    height: 80,
    url: '<%= note.audioPath %>',
  });
  ws.on('ready', () => {
    document.getElementById('timeDisplay').textContent = '0:00 / ' + formatTime(ws.getDuration());
  });
  ws.on('audioprocess', () => {
    document.getElementById('timeDisplay').textContent = formatTime(ws.getCurrentTime()) + ' / ' + formatTime(ws.getDuration());
  });
}

function formatTime(t) {
  const m = Math.floor(t / 60);
  const s = Math.floor(t % 60);
  return m + ':' + (s < 10 ? '0' : '') + s;
}

window.togglePlay = function() {
  if (!ws) return;
  ws.playPause();
  document.getElementById('playBtn').textContent = ws.isPlaying() ? '⏸ 暂停' : '▶ 播放';
};

document.addEventListener('DOMContentLoaded', () => {
  <% if (note.audioPath) { %>
  initWaveform();
  <% } %>

  // 录制中 / 处理中：自动刷新内容
  <% if (note.status === 'recording' || note.status === 'processing') { %>

  // 处理中：轮询直到完成（显示逐步优化的转写）
  let refreshCount = 0;
  function scheduleRefresh() {
    const interval = <%= note.status === 'recording' ? 8000 : 5000 %>;
    const timer = setTimeout(() => {
      fetch(window.location.href, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
        .then(r => r.text())
        .then(html => {
          const parser = new DOMParser();
          const doc = parser.parseFromString(html, 'text/html');
          const newTag = doc.querySelector('.tag');
          const isStillProcessing = newTag && newTag.classList.contains('tag-warning') && newTag.textContent.includes('处理中');
          const isRecording = newTag && newTag.classList.contains('tag-recording');

          // 如果状态变了，整页刷新
          if (!isStillProcessing && !isRecording) {
            window.location.reload();
            return;
          }

          // 转录文字变化 → 就地更新
          const allNew = doc.querySelectorAll('.md-body');
          const allOld = document.querySelectorAll('.md-body');
          if (allNew.length === allOld.length + 1) allNew.shift();
          for (let i = 0; i < Math.min(allNew.length, allOld.length); i++) {
            if (allNew[i].textContent !== allOld[i].textContent) {
              allOld[i].textContent = allNew[i].textContent;
            }
          }

          refreshCount++;
          scheduleRefresh();
        }).catch(() => { scheduleRefresh(); });
    }, interval);
  }

  <% if (note.status === 'recording') { %>
  const viewingInterval = setInterval(() => {
    fetch('/api/notes/<%= note.id %>/viewing', { method: 'POST' }).catch(() => {});
  }, 5000);
  <% } %>

  scheduleRefresh();

  window.addEventListener('beforeunload', () => {
    if (typeof viewingInterval !== 'undefined') clearInterval(viewingInterval);
  });
  <% } %>
});

// ─── 修改日志 ──────────────────────────────────────
(async function loadRevisions() {
  try {
    const res = await fetch('/api/notes/<%= note.id %>');
    const data = await res.json();
    const logs = data.revisions || [];
    if (logs.length === 0) return;

    document.getElementById('revisionCard').style.display = 'block';
    document.getElementById('revisionCount').textContent = '(' + logs.length + ' 次修改)';

    const stages = { asr: '🤖 ASR 替换', polish_chunk_1: '✨ 第1段润色', polish_chunk_2: '✨ 第2段润色', polish_chunk_3: '✨ 第3段润色', polish_chunk_4: '✨ 第4段润色', polish_chunk_5: '✨ 第5段润色', polish_final: '✅ 最终润色' };

    let html = '<div style="border-left:2px solid #e2e8f0;padding-left:16px;">';
    for (const log of logs) {
      const label = stages[log.stage] || '📝 ' + log.stage;
      const time = log.created_at ? new Date(log.created_at).toLocaleTimeString('zh-CN') : '';
      const diff = log.chars_changed > 0 ? '+' + log.chars_changed + ' 字' : log.chars_changed + ' 字';
      const diffColor = log.chars_changed > 0 ? '#16a34a' : '#dc2626';
      html += '<div style="margin-bottom:20px;position:relative;">';
      html += '<div style="position:absolute;left:-22px;top:2px;width:8px;height:8px;border-radius:50%;background:#4f46e5;"></div>';
      html += '<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:4px;">';
      html += '<span style="font-weight:600;font-size:13px;">' + label + '</span>';
      html += '<span style="font-size:11px;color:var(--text-muted);">' + time + ' · <span style="color:' + diffColor + ';">' + diff + '</span></span>';
      html += '</div>';

      // 找前 200 字中前 3 个不同之处
      const changes = findDiffs(log.old_text || '', log.new_text || '', 3);
      html += '<div style="font-size:12px;line-height:1.6;color:#64748b;background:#f8fafc;border-radius:4px;padding:8px;">';
      for (const c of changes) {
        html += c + '<br>';
      }
      html += '</div>';
      html += '</div>';
    }
    html += '</div>';
    document.getElementById('revisionTimeline').innerHTML = html;
  } catch(_) {}
})();

function findDiffs(old, new_, max) {
  const result = [];
  const oldWords = old.split('');
  const newWords = new_.split('');
  let i = 0, j = 0, found = 0;
  while (i < oldWords.length && j < newWords.length && found < max) {
    if (oldWords[i] !== newWords[j]) {
      // 找相同点
      let oi = i, ni = j, diffOld = '', diffNew = '';
      while ((oi < oldWords.length || ni < newWords.length) && found < max) {
        if (oi < oldWords.length && ni < newWords.length && oldWords[oi] === newWords[ni]) break;
        if (oi < oldWords.length) diffOld += oldWords[oi++];
        if (ni < newWords.length) diffNew += newWords[ni++];
        if (diffOld.length > 15 && diffNew.length > 15) break;
      }
      if (diffOld || diffNew) {
        const ctxOld = oldWords.slice(Math.max(0, i - 8), i).join('');
        const label = diffOld && diffNew ? '<span style="color:#dc2626;text-decoration:line-through;">' + ctxOld + diffOld.slice(0, 20) + '</span> → <span style="color:#16a34a;">' + diffNew.slice(0, 20) + '</span>' : (diffOld ? '<span style="color:#dc2626;">删除：' + ctxOld + diffOld.slice(0, 20) + '</span>' : '<span style="color:#16a34a;">新增：' + diffNew.slice(0, 20) + '</span>');
        result.push(label);
        found++;
      }
      i = oi; j = ni;
    } else {
      i++; j++;
    }
  }
  return result.length > 0 ? result : ['（润色优化）'];
}

// ─── 思维导图 ──────────────────────────────────────
let mmRendered = false;
window.toggleMindMap = function() {
  const text = document.getElementById('mmText');
  const canvas = document.getElementById('mmCanvas');
  const btn = document.getElementById('mmToggle');
  if (!text || !canvas) return;

  if (canvas.style.display === 'none') {
    text.style.display = 'none';
    canvas.style.display = 'block';
    btn.textContent = '切换文本视图';
    if (!mmRendered) renderMindMap();
  } else {
    text.style.display = 'block';
    canvas.style.display = 'none';
    btn.textContent = '切换脑图视图';
  }
};

function renderMindMap() {
  const canvas = document.getElementById('mmCanvas');
  const pre = document.getElementById('mmRaw');
  if (!canvas || !pre) return;

  const raw = pre.textContent;
  let json;
  try {
    // 去掉 markdown 代码块标记
    const clean = raw.replace(/^```[\w]*\n?/, '').replace(/\n?```$/, '');
    json = JSON.parse(clean);
  } catch(e) {
    canvas.innerHTML = '<p class="text-muted">思维导图JSON解析失败</p>';
    return;
  }

  // 递归转换 JSON 为 markdown 列表
  function toMarkdown(obj, depth) {
    if (typeof obj === 'string') return '  '.repeat(depth) + '- ' + obj + '\n';
    let md = '';
    const name = obj['名称'] || obj['中心主题'] || '';
    const desc = obj['说明'] || '';
    const children = obj['子节点'] || obj['分支'] || [];
    if (name) md += '  '.repeat(depth) + '- **' + name + '**' + (desc ? ': ' + desc : '') + '\n';
    if (Array.isArray(obj)) {
      for (const child of obj) md += toMarkdown(child, depth + 1);
    } else if (children.length > 0) {
      for (const child of children) md += toMarkdown(child, depth + 1);
    }
    return md;
  }

  const mdContent = toMarkdown(json, 0);
  if (mdContent) {
    const { Transformer } = window.markmap;
    const transformer = new Transformer();
    const { root } = transformer.transform(mdContent);
    const { Markmap } = window.markmap;
    Markmap.create('#mmCanvas', {
      colorFreezeLevel: 2,
      duration: 300,
      maxWidth: 300,
      nodeMinHeight: 24,
      spacingHorizontal: 60,
      spacingVertical: 8,
      zoomOnMaxHeight: true,
      pan: true,
      zoom: true,
    }, root);
    mmRendered = true;
  }
}

async function confirmCourseSuggestion() {
  const res = await fetch('/api/notes/<%= note.id %>/confirm-course', { method: 'POST' });
  if (res.ok) window.location.reload();
  else showToast('确认失败', 'error');
}

async function dismissCourseSuggestion() {
  const res = await fetch('/api/notes/<%= note.id %>/dismiss-course', { method: 'POST' });
  if (res.ok) window.location.reload();
  else showToast('忽略失败', 'error');
}

async function deleteNote() {
  if (!confirm('确定删除这条笔记？相关音频和照片也会被删除。')) return;
  try {
    const res = await fetch('/api/notes/<%= note.id %>', { method: 'DELETE' });
    const data = await res.json();
    if (data.ok) {
      window.location.href = '/notes';
    } else {
      showToast('删除失败: ' + (data.error || '未知错误'), 'error');
    }
  } catch(e) {
    showToast('请求失败', 'error');
  }
}

async function stopRecording() {
  if (!confirm('确定停止录音？')) return;
  try {
    const res = await fetch('/api/notes/<%= note.id %>/stop-recording', { method: 'POST' });
    const data = await res.json();
    if (data.ok) {
      window.location.reload();
    } else {
      showToast('操作失败: ' + (data.error || '未知错误'), 'error');
    }
  } catch(e) {
    showToast('请求失败', 'error');
  }
}

async function resumeRecording() {
  try {
    const res = await fetch('/api/notes/<%= note.id %>/resume-recording', { method: 'POST' });
    const data = await res.json();
    if (data.ok) {
      showToast('已发送录音指令，设备检测到声音后将创建新笔记继续录音', 'success');
      window.location.href = '/notes';
    } else {
      showToast('操作失败: ' + (data.error || '未知错误'), 'error');
    }
  } catch(e) {
    showToast('请求失败', 'error');
  }
}

async function capturePhoto() {
  try {
    const res = await fetch('/api/notes/<%= note.id %>/capture', { method: 'POST' });
    const data = await res.json();
    if (data.ok) {
      showToast('拍照指令已发送，请稍后刷新查看照片', 'success');
      setTimeout(() => window.location.reload(), 3000);
    } else {
      showToast('操作失败: ' + (data.error || '未知错误'), 'error');
    }
  } catch(e) {
    showToast('请求失败', 'error');
  }
}
</script>

<h2>搜索笔记</h2>
<div class="card mt-2">
  <form action="/notes/search" method="GET">
    <div style="display:flex;gap:8px;">
      <input type="text" name="q" class="form-input" placeholder="输入关键词搜索笔记全文..." style="flex:1">
      <button type="submit" class="btn btn-primary">搜索</button>
    </div>
  </form>
</div>
<div class="card mt-2">
  <p class="text-muted text-center">输入关键词开始搜索</p>
</div>

<div class="flex-between">
  <h2>课程列表</h2>
  <a href="/courses/new" class="btn btn-primary">新建课程</a>
</div>
<% if (!courses || courses.length === 0) { %>
<div class="card mt-2">
  <p class="text-muted text-center">暂无课程</p>
</div>
<% } else { %>
<div class="card mt-2" style="padding:0;overflow:hidden;">
  <table style="width:100%;border-collapse:collapse;">
    <thead>
      <tr style="background:#fafafa;">
        <th style="padding:12px;text-align:left;border-bottom:1px solid #eee;">课程名称</th>
        <th style="padding:12px;text-align:left;border-bottom:1px solid #eee;">学期</th>
        <th style="padding:12px;text-align:left;border-bottom:1px solid #eee;">描述</th>
        <th style="padding:12px;text-align:right;border-bottom:1px solid #eee;">操作</th>
      </tr>
    </thead>
    <tbody>
      <% for (const c of courses) { %>
      <tr>
        <td style="padding:12px;border-bottom:1px solid #f5f5f5;font-weight:500;"><%= c.name %></td>
        <td style="padding:12px;border-bottom:1px solid #f5f5f5;color:var(--text-muted);"><%= c.semester || '-' %></td>
        <td style="padding:12px;border-bottom:1px solid #f5f5f5;color:var(--text-muted);"><%= c.description || '-' %></td>
        <td style="padding:12px;border-bottom:1px solid #f5f5f5;text-align:right;">
          <a href="/courses/<%= c.id %>/edit" class="btn btn-outline btn-sm">编辑</a>
        </td>
      </tr>
      <% } %>
    </tbody>
  </table>
</div>
<% } %>

    "ejs": "^3.1.10",
    "hono": "^4.6.5",
    "jose": "^5.9.6",
    "marked": "^14.1.4",
    "mqtt": "^5.10.1",
    "qiniu": "^7.14.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.12",
    "@types/ejs": "^3.1.5",
    "@types/mqtt": "^2.5.0",
    "drizzle-kit": "^0.28.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^4.1.8"

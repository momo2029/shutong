# 书童项目环境变量配置模板
# 复制此文件为 .env 并填入真实值

# JWT 密钥 (生成方式: openssl rand -hex 32)
JWT_SECRET=

# MQTT 服务端连接凭证
MQTT_BROKER=mqtt://emqx:1883
MQTT_USER=sht_server
MQTT_PASSWORD=

# MQTT 设备认证 Master Key (生成方式: openssl rand -hex 32)
# 用于生成设备个性化凭证的主密钥，严格保密
DEVICE_MASTER_KEY=

# EMQX 管理 API 凭证 (用于自动创建设备用户)
EMQX_API_USER=admin
EMQX_API_PASSWORD=public

# 七牛云对象存储 (可选，留空则使用本地存储)
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=
QINIU_DOMAIN=

# AI 服务 API (可选)
ASR_API_KEY=
OCR_API_KEY=
LLM_API_KEY=
LLM_API_URL=

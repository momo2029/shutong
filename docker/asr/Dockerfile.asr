FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

# Copy pre-compiled llama-cli binary (built separately on Mac with zig)
COPY bin/llama-cli /usr/local/bin/llama-cli
RUN chmod +x /usr/local/bin/llama-cli

# Create model directory
RUN mkdir -p /models

# Copy server script
WORKDIR /app
COPY llama_server.py .

EXPOSE 8888

CMD ["python3", "llama_server.py"]

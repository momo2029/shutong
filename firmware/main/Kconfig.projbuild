menu "书童 硬件配置"

choice SHUTONG_VARIANT
    prompt "硬件版本"
    default SHUTONG_STANDARD

config SHUTONG_STANDARD
    bool "标准版 (ESP32, 无摄像头)"
config SHUTONG_FLAGSHIP
    bool "旗舰版 (ESP32-S3, OV2640摄像头)"
endchoice

config SHUTONG_SN
    string "设备序列号 (SN)"
    default "0000000000"
    help
        设备唯一序列号，10位数字。建议用Unix时间戳（date +%s），
        防止重复。烧录前执行: SN=$(date +%s) idf.py build

config MQTT_BROKER_URL
    string "MQTT Broker URL"
    default "mqtt://shutong.3198.net:1883"

config MQTT_USERNAME
    string "MQTT 用户名"
    default ""
    help
        开发兼容用固定用户名。生产环境应留空并设置 MQTT_MASTER_KEY，
        固件会自动生成 device:timestamp:signature 动态用户名。

config MQTT_PASSWORD
    string "MQTT 密码"
    default ""
    help
        固定用户名对应密码。生产环境使用动态签名时留空。

config MQTT_MASTER_KEY
    string "MQTT 主密钥"
    default ""
    help
        用于生成MQTT username签名的主密钥。开发环境通过 menuconfig 设置，
        不要提交到代码。

config WIFI_SSID_DEFAULT
    string "默认WiFi SSID"
    default "13"

config WIFI_PASS_DEFAULT
    string "默认WiFi密码"
    default "333666999"

endmenu
